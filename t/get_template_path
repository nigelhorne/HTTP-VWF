#!/usr/bin/env perl

# Test HTTP::VWF::Display::get_template_path
# Must be run from within the '.../HTTP-VWF/t' directory, with root_dir set
# to the distribution root:
#   cd t && root_dir=$(realpath ..) perl -I../lib get_template_path

use strict;
use warnings;

use Cwd;
use FindBin qw($Bin);
use Test::More tests => 1;

use lib "$Bin/../lib";

use HTTP::VWF::Display;

{
	package MockLogger;
	sub new { bless {}, shift }
	sub trace { shift; ::diag "TRACE: @_\n" }
	sub info { shift; ::diag "INFO: @_\n" }
	sub debug { shift; ::diag "DEBUG: @_\n" }
	sub error { shift; ::diag "ERROR: @_\n" }
	# sub trace { }
	# sub info { }
	# sub debug { }
}

{
	package MockLingua;
	sub new { bless { }, shift }
	sub requested_language { 'en-US' }
	sub code_alpha2 { 'en' }
	sub language_code_alpha2 { 'en' }
	sub sublanguage_code_alpha2 { 'US' }
	sub locale { }
}

{
	package MockInfo;
	sub new { bless { }, shift }
	sub root_dir { Cwd::abs_path(File::Spec->catdir(Cwd::getcwd(), File::Spec->updir())) }
	sub params { }
	sub param { }
	sub is_search_engine { 0 }
	sub is_mobile { 0 }
	sub is_ai { 0 }
	sub is_robot { 0 }
	sub script_dir { Cwd::getcwd() }
	sub domain_name { 'example.com' }
}

# $ENV{'GATEWAY_INTERFACE'} = 'CGI/1.1';
# $ENV{'REQUEST_METHOD'} = 'GET';
# $ENV{'QUERY_STRING'} = '';

{
	package HTTP::VWF::Display::index;
	our @ISA = ('HTTP::VWF::Display');
}

my $self = HTTP::VWF::Display::index->new(info => MockInfo->new(), lingua => MockLingua->new(), logger => MockLogger->new());

# Run the function and catch results
eval {
	my $template_path = $self->get_template_path();
	like($template_path, qr{templates/en/web/HTTP/VWF/Display/index\.tmpl$}, "Template path found: $template_path");
};

if ($@) {
	fail("get_template_path failed with error: $@");
}

